---
interface Link {
  href: string;
  sectionId: string;
  title: string;
}

interface Props {
  prev?: Link;
  next?: Link;
}

const { prev, next } = Astro.props;
---

<nav class="mt-8 grid gap-4 font-sans sm:grid-cols-2" aria-label="Navegación entre secciones">
  {prev ? (
    <a
      href={prev.href}
      class="rounded-xl border border-surface-2 px-5 py-4 transition-colors hover:border-accent"
    >
      <span class="block text-xs text-muted">← Anterior · {prev.sectionId}</span>
      <span class="mt-1 block font-semibold">{prev.title}</span>
    </a>
  ) : (
    <span />
  )}
  {next && (
    <a
      href={next.href}
      class="rounded-xl border border-surface-2 px-5 py-4 text-right transition-colors hover:border-accent"
    >
      <span class="block text-xs text-muted">Siguiente · {next.sectionId} →</span>
      <span class="mt-1 block font-semibold">{next.title}</span>
    </a>
  )}
</nav>
