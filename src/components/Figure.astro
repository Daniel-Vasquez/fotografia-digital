---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}

const { src, alt, caption = alt, width = 1376, height = 768 } = Astro.props;
---

<figure class="not-prose my-10">
  <img
    src={encodeURI(src)}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    class="h-auto w-full rounded-xl border border-surface-2 bg-surface"
  />
  <figcaption class="mt-3 text-center font-sans text-sm text-muted">{caption}</figcaption>
</figure>
