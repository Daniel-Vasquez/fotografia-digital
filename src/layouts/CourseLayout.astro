---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface TocItem {
  href: string;
  sectionId: string;
  title: string;
  current: boolean;
}

interface Props {
  title: string;
  description: string;
  courseTitle: string;
  plannedSections: number;
  toc: TocItem[];
}

const { title, description, courseTitle, plannedSections, toc } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Dani Academy</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Antes de pintar, para no ver un parpadeo del tema equivocado
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <header class="border-b border-surface-2">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href="/" class="font-serif text-lg font-semibold tracking-tight">
          Dani Academy
        </a>
        <button
          id="theme-toggle"
          type="button"
          class="rounded-lg border border-surface-2 px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-fg"
          aria-label="Cambiar entre modo claro y oscuro"
        >
          <span class="dark:hidden">Modo oscuro</span>
          <span class="hidden dark:inline">Modo claro</span>
        </button>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:grid lg:grid-cols-[16rem_1fr] lg:gap-12">
      <aside class="mb-10 lg:mb-0">
        <details class="group rounded-xl border border-surface-2 p-4 lg:sticky lg:top-8" open>
          <summary class="cursor-pointer list-none text-sm font-semibold lg:cursor-default">
            {courseTitle}
            <span class="mt-1 block text-xs font-normal text-muted">
              {toc.length} de {plannedSections} secciones publicadas
            </span>
          </summary>
          <ol class="mt-4 space-y-1 text-sm">
            {toc.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.current ? "page" : undefined}
                  class:list={[
                    "block rounded-md px-2 py-1.5 transition-colors",
                    item.current
                      ? "bg-surface font-semibold text-accent-strong"
                      : "text-muted hover:text-fg",
                  ]}
                >
                  <span class="mr-1 tabular-nums">{item.sectionId}</span>
                  {item.title}
                </a>
              </li>
            ))}
          </ol>
        </details>
      </aside>

      <main>
        <slot />
      </main>
    </div>

    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Sin localStorage, el tema dura lo que la página
        }
      });
    </script>
  </body>
</html>
